{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Common Golf Protocol channel 1: shot (measured at launch)",
  "type": "object",
  "required": ["type", "shot_uuid", "ball_speed_meters_per_second", "vertical_launch_angle_degrees", "horizontal_launch_angle_degrees"],
  "properties": {
    "type": {"const": "shot"},
    "shot_uuid": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "UUIDv7 in lowercase hyphenated form. Identifies the same shot across channels, updates, and reconnects; independent of measured_at."
    },
    "ball_speed_meters_per_second": {"type": "number", "minimum": 0},
    "vertical_launch_angle_degrees": {"type": "number", "minimum": -90, "maximum": 90},
    "horizontal_launch_angle_degrees": {"type": "number", "minimum": -90, "maximum": 90},
    "total_spin_revolutions_per_minute": {"type": "number", "description": "Negative is topspin"},
    "spin_axis_degrees": {"type": "number", "minimum": -90, "maximum": 90, "description": "Positive curves right, whatever the sign of total spin"},
    "backspin_revolutions_per_minute": {"type": "number"},
    "sidespin_revolutions_per_minute": {"type": "number"},
    "measured_at": {"type": "string", "format": "date-time", "description": "UTC RFC 3339 measurement timestamp, independent of the timestamp embedded in shot_uuid; omit if unknown."},
    "player_dexterity": {"enum": ["right", "left", "unknown"]},
    "tee_position": {"enum": ["tee", "mat", "ground", "unknown"]},
    "estimated": {
      "type": "array",
      "uniqueItems": true,
      "description": "Numeric fields the device could not measure for this shot, or believes to have reduced accuracy. A sender MUST name only fields present in the message. A receiver ignores any other name",
      "items": {"type": "string"}
    },
    "shot_kind": {"enum": ["full", "putt", "chip"]}
  },
  "dependentRequired": {
    "total_spin_revolutions_per_minute": ["spin_axis_degrees"],
    "spin_axis_degrees": ["total_spin_revolutions_per_minute"],
    "backspin_revolutions_per_minute": ["total_spin_revolutions_per_minute", "sidespin_revolutions_per_minute"],
    "sidespin_revolutions_per_minute": ["total_spin_revolutions_per_minute", "backspin_revolutions_per_minute"]
  }
}
