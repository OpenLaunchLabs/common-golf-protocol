{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Common Golf Protocol custom contract io.common-golf.open-connect-v1: Open Connect v1 bodies, plus one optional CGP field",
  "description": "Payload schema for a server-assigned custom channel in draft 3, not fixed channel 2. Open Connect v1 request bodies may include the optional CGP shot_uuid field; replies are unchanged. Drafts 1 and 2 carried Open Connect on channel 2.",
  "oneOf": [
    {
      "type": "object",
      "required": ["DeviceID", "ShotNumber", "APIversion", "ShotDataOptions"],
      "properties": {
        "DeviceID": {"type": "string"},
        "Units": {"type": "string"},
        "ShotNumber": {"type": "integer", "minimum": 0},
        "shot_uuid": {
          "type": "string",
          "format": "uuid",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "Optional CGP UUIDv7 in lowercase hyphenated form. Identifies the same shot across channels, updates, and reconnects; MUST match channel 1's shot_uuid when the same shot is sent there."
        },
        "APIversion": {"const": "1"},
        "BallData": {
          "type": "object",
          "required": ["Speed", "SpinAxis", "HLA", "VLA"],
          "properties": {
            "Speed": {"type": "number"}, "SpinAxis": {"type": "number"}, "TotalSpin": {"type": "number"},
            "BackSpin": {"type": "number"}, "SideSpin": {"type": "number"},
            "HLA": {"type": "number"}, "VLA": {"type": "number"}, "CarryDistance": {"type": "number"}
          }
        },
        "ClubData": {
          "type": "object",
          "properties": {
            "Speed": {"type": "number"}, "AngleOfAttack": {"type": "number"}, "FaceToTarget": {"type": "number"},
            "Lie": {"type": "number"}, "Loft": {"type": "number"}, "Path": {"type": "number"},
            "SpeedAtImpact": {"type": "number"}, "VerticalFaceImpact": {"type": "number"},
            "HorizontalFaceImpact": {"type": "number"}, "ClosureRate": {"type": "number"}
          }
        },
        "ShotDataOptions": {
          "type": "object",
          "required": ["ContainsBallData"],
          "properties": {
            "ContainsBallData": {"type": "boolean"}, "ContainsClubData": {"type": "boolean"},
            "LaunchMonitorIsReady": {"type": "boolean"}, "LaunchMonitorBallDetected": {"type": "boolean"},
            "IsHeartBeat": {"type": "boolean"}
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["Code", "Message"],
      "properties": {
        "Code": {"type": "integer"},
        "Message": {"type": "string"},
        "Player": {
          "type": "object",
          "properties": {"Handed": {"type": "string"}, "Club": {"type": "string"}, "DistanceToTarget": {"type": "number"}}
        }
      }
    }
  ]
}
