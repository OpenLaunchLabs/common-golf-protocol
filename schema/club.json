{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Common Golf Protocol channel 3: club (measured at impact, or a standalone swing)",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": {"const": "club"},
    "shot_uuid": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "UUIDv7 in lowercase hyphenated form. Identifies the same shot across channels, updates, and reconnects; independent of measured_at. A standalone swing may have its own shot_uuid."
    },
    "club_speed_meters_per_second": {"type": "number", "minimum": 0},
    "angle_of_attack_degrees": {"type": "number"},
    "club_path_degrees": {"type": "number"},
    "face_angle_degrees": {"type": "number"},
    "face_to_path_degrees": {"type": "number"},
    "dynamic_loft_degrees": {"type": "number"},
    "spin_loft_degrees": {"type": "number"},
    "smash_factor": {"type": "number", "minimum": 0},
    "swing_direction_degrees": {"type": "number"},
    "swing_plane_degrees": {"type": "number"},
    "swing_radius_meters": {"type": "number", "minimum": 0},
    "d_plane_tilt_degrees": {"type": "number"},
    "low_point_distance_meters": {"type": "number"},
    "low_point_height_meters": {"type": "number"},
    "low_point_side_meters": {"type": "number"},
    "lie_degrees": {"type": "number"},
    "speed_at_impact_meters_per_second": {"type": "number", "minimum": 0},
    "face_impact_horizontal_millimeters": {"type": "number"},
    "face_impact_vertical_millimeters": {"type": "number"},
    "closure_rate_degrees_per_second": {"type": "number"},
    "estimated": {
      "type": "array",
      "uniqueItems": true,
      "description": "Numeric fields the device could not measure for this shot, or believes to have reduced accuracy. A sender MUST name only fields present in the message. A receiver ignores any other name",
      "items": {"type": "string"}
    },
    "player_dexterity": {"enum": ["right", "left", "unknown"]}
  }
}
