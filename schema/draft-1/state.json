{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Common Golf Protocol channel 6: state (simulator context, sent on open and on change)",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": {"const": "state"},
    "ready": {"type": ["boolean", "null"]},
    "player": {
      "type": ["object", "null"],
      "properties": {
        "name": {"type": "string"},
        "dexterity": {"enum": ["right", "left", "unknown"]}
      }
    },
    "club": {
      "type": ["object", "null"],
      "properties": {
        "id": {"type": "string", "description": "Common abbreviation such as DR, 3W, 7I, PW, PT"},
        "name": {"type": "string"}
      }
    },
    "mode": {"enum": ["range", "course", "putting", null]},
    "ball_zone": {
      "type": ["object", "null"],
      "required": ["x_meters", "y_meters", "width_meters", "height_meters"],
      "properties": {
        "x_meters": {"type": "number"},
        "y_meters": {"type": "number"},
        "width_meters": {"type": "number", "minimum": 0},
        "height_meters": {"type": "number", "minimum": 0}
      }
    }
  }
}
