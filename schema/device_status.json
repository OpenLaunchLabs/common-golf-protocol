{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Common Golf Protocol channel 4: device_status (device state, sent on change)",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": {"const": "device_status"},
    "ready": {"type": ["boolean", "null"]},
    "capture_mode": {"enum": ["full", "short", "putting", null]},
    "ball_detected": {"type": ["boolean", "null"]},
    "ball_zone": {
      "type": ["object", "null"],
      "required": ["x_meters", "y_meters", "width_meters", "height_meters"],
      "properties": {
        "x_meters": {"type": "number"},
        "y_meters": {"type": "number"},
        "width_meters": {"type": "number", "minimum": 0},
        "height_meters": {"type": "number", "minimum": 0}
      }
    },
    "ball_position": {
      "type": ["object", "null"],
      "required": ["x_meters", "y_meters"],
      "properties": {
        "x_meters": {"type": "number"},
        "y_meters": {"type": "number"}
      }
    },
    "battery_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "uptime_seconds": {"type": ["number", "null"], "minimum": 0},
    "message": {"type": ["string", "null"]}
  },
  "description": "Sent in full on open, then only changed fields. Absent is unchanged, null clears."
}
